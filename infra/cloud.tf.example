# Облачный вариант, если машина нужна не локально. Назван .example намеренно:
# ему нужны свой счёт и свои ключи, а `terraform apply`, который никто не может
# применить, доказывает меньше, чем локальный, который отрабатывает.
#
# Переименовать в cloud.tf, убрать libvirt из main.tf, задать переменные.
#
# resource "yandex_compute_instance" "bench" {
#   name        = var.name
#   platform_id = "standard-v3"
#   resources { cores = var.vcpus, memory = var.memory_mb / 1024 }
#   boot_disk { initialize_params { image_id = var.image_id, size = 20 } }
#   network_interface { subnet_id = var.subnet_id, nat = true }
#   metadata = { ssh-keys = "${var.ssh_user}:${file(var.ssh_public_key)}" }
# }
#
# output "address" { value = yandex_compute_instance.bench.network_interface.0.nat_ip_address }
